{
  "manifest_version": 3,
  "name": "Gemini Model Auto-Switch",
  "version": "1.3.0",
  "description": "Tự động chọn model và mức tư duy đã ghim trên gemini.google.com mỗi lần tải trang.",
  "icons": {
    "128": "icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-model-switch@pixel3d.local",
      "strict_min_version": "127.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://gemini.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "css": ["quiet.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Gemini Model Auto-Switch",
    "default_icon": "icon-128.png",
    "default_popup": "popup.html"
  }
}
