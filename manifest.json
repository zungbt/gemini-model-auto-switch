{
  "manifest_version": 3,
  "name": "Gemini Model Auto-Switch",
  "version": "1.2.0",
  "description": "Tự động chọn model đích trên gemini.google.com mỗi khi mở hội thoại.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-model-switch@pixel3d.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://gemini.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "css": ["quiet.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Gemini Model Auto-Switch",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  }
}
